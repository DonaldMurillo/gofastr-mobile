import UIKit
import {{.Prefix}}

private struct NoteSnapshot {
    let id: String
    let title: String
    let body: String

    init(_ note: {{.Prefix}}Note) {
        id = note.id_
        title = note.title
        body = note.body
    }
}

private enum NotesStore {
    static let queue = DispatchQueue(label: "notes.native.commands", qos: .userInitiated)

    static func failure(_ error: NSError?) -> NSError {
        error ?? NSError(domain: "Notes", code: 1, userInfo: [NSLocalizedDescriptionKey: "Notes is unavailable. Please try again."])
    }

    static func list(_ search: String, completion: @escaping (Result<[NoteSnapshot], Error>) -> Void) {
        queue.async {
            var error: NSError?
            let result: Result<[NoteSnapshot], Error>
            if let snapshot = {{.Prefix}}List(search, &error) {
                result = .success((0..<snapshot.count()).compactMap { snapshot.item($0).map(NoteSnapshot.init) })
            } else {
                result = .failure(failure(error))
            }
            DispatchQueue.main.async { completion(result) }
        }
    }

    static func save(_ id: String, title: String, body: String, completion: @escaping (Result<NoteSnapshot, Error>) -> Void) {
        queue.async {
            var error: NSError?
            let result: Result<NoteSnapshot, Error>
            if let saved = {{.Prefix}}Save(id, title, body, &error) {
                result = .success(NoteSnapshot(saved))
            } else {
                result = .failure(failure(error))
            }
            DispatchQueue.main.async { completion(result) }
        }
    }
}

@main
final class AppDelegate: UIResponder, UIApplicationDelegate {
    var window: UIWindow?

    func application(_ application: UIApplication, didFinishLaunchingWithOptions options: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {
        let window = UIWindow(frame: UIScreen.main.bounds)
        let list = NotesListController(style: .insetGrouped)
        let navigation = UINavigationController(rootViewController: list)
        navigation.navigationBar.prefersLargeTitles = true
        window.rootViewController = navigation
        window.tintColor = .systemOrange
        window.makeKeyAndVisible()
        self.window = window
        let directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
            .appendingPathComponent("app", isDirectory: true).path
        NotesStore.queue.async {
            var error: NSError?
            let started = {{.Prefix}}Start(directory, &error)
            DispatchQueue.main.async {
                if started {
                    list.start()
                } else {
                    list.showFailure(NotesStore.failure(error))
                }
            }
        }
        return true
    }

    func applicationWillTerminate(_ application: UIApplication) {
        var error: NSError?
        _ = {{.Prefix}}Stop(&error)
    }
}

private final class NotesListController: UITableViewController, UISearchResultsUpdating {
    private var notes: [NoteSnapshot] = []
    private let search = UISearchController(searchResultsController: nil)
    private var pendingSearch: DispatchWorkItem?
    private var revision = 0
    private var ready = false
    private lazy var composeButton = UIBarButtonItem(barButtonSystemItem: .compose, target: self, action: #selector(compose))

    override func viewDidLoad() {
        super.viewDidLoad()
        title = "Notes"
        navigationItem.prompt = "On this device"
        composeButton.accessibilityIdentifier = "notes.compose"
        composeButton.accessibilityLabel = "New note"
        composeButton.isEnabled = false
        navigationItem.rightBarButtonItem = composeButton
        navigationItem.leftBarButtonItem = UIBarButtonItem(image: UIImage(systemName: "info.circle"), style: .plain, target: self, action: #selector(showInfo))
        navigationItem.leftBarButtonItem?.accessibilityLabel = "About native Notes"
        search.searchResultsUpdater = self
        search.obscuresBackgroundDuringPresentation = false
        search.searchBar.placeholder = "Search your notes"
        search.searchBar.accessibilityIdentifier = "notes.search"
        navigationItem.searchController = search
        navigationItem.hidesSearchBarWhenScrolling = false
        definesPresentationContext = true
        tableView.keyboardDismissMode = .onDrag
        tableView.estimatedRowHeight = 84
        tableView.rowHeight = UITableView.automaticDimension
        tableView.register(UITableViewCell.self, forCellReuseIdentifier: "note")
        refreshControl = UIRefreshControl()
        refreshControl?.addTarget(self, action: #selector(refresh), for: .valueChanged)
        showEmpty("Opening your notes…")
    }

    override func viewWillAppear(_ animated: Bool) {
        super.viewWillAppear(animated)
        navigationController?.interactivePopGestureRecognizer?.isEnabled = true
        if ready { refresh() }
    }

    func start() {
        ready = true
        composeButton.isEnabled = true
        refresh()
    }

    @objc private func refresh() {
        guard ready else { return }
        pendingSearch?.cancel()
        revision += 1
        let requestedRevision = revision
        let query = search.searchBar.text ?? ""
        NotesStore.list(query) { [weak self] result in
            guard let self, self.revision == requestedRevision else { return }
            self.refreshControl?.endRefreshing()
            switch result {
            case .success(let notes):
                self.notes = notes
                self.tableView.reloadData()
                if notes.isEmpty {
                    self.showEmpty(query.isEmpty ? "Make room for an idea.\nTap New note to start writing." : "No matching notes.\nTry another word.")
                } else {
                    self.tableView.backgroundView = nil
                }
            case .failure(let error):
                self.showFailure(error)
            }
        }
    }

    func updateSearchResults(for searchController: UISearchController) {
        pendingSearch?.cancel()
        revision += 1
        let task = DispatchWorkItem { [weak self] in self?.refresh() }
        pendingSearch = task
        DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(180), execute: task)
    }

    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { notes.count }

    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
        let cell = tableView.dequeueReusableCell(withIdentifier: "note", for: indexPath)
        let note = notes[indexPath.row]
        var content = cell.defaultContentConfiguration()
        content.text = note.title
        content.secondaryText = note.body.isEmpty ? "No additional text" : note.body
        content.textProperties.font = .preferredFont(forTextStyle: .headline)
        content.textProperties.numberOfLines = 0
        content.secondaryTextProperties.numberOfLines = 2
        content.secondaryTextProperties.color = .secondaryLabel
        cell.contentConfiguration = content
        cell.accessoryType = .disclosureIndicator
        cell.accessibilityIdentifier = "notes.row.\(note.id)"
        return cell
    }

    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
        UISelectionFeedbackGenerator().selectionChanged()
        open(notes[indexPath.row])
    }

    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
        search.searchBar.text?.isEmpty == false ? "Search results" : "All notes"
    }

    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
        let count = notes.count == 1 ? "1 note" : "\(notes.count) notes"
        return "\(count) · Stored on this device · Available offline"
    }

    @objc private func compose() { open(nil) }

    private func open(_ note: NoteSnapshot?) {
        let editor = NoteEditorController(note: note)
        navigationController?.pushViewController(editor, animated: true)
    }

    @objc private func showInfo() {
        let info = NativeInfoController()
        let sheet = UINavigationController(rootViewController: info)
        sheet.sheetPresentationController?.detents = [.medium(), .large()]
        sheet.sheetPresentationController?.prefersGrabberVisible = true
        present(sheet, animated: true)
    }

    private func showEmpty(_ message: String) {
        let label = UILabel()
        label.text = message
        label.font = .preferredFont(forTextStyle: .body)
        label.adjustsFontForContentSizeCategory = true
        label.textColor = .secondaryLabel
        label.numberOfLines = 0
        label.textAlignment = .center
        tableView.backgroundView = label
    }
}

private final class NoteEditorController: UIViewController, UITextViewDelegate, UITextFieldDelegate {
    private var noteID: String
    private var savedTitle: String
    private var savedBody: String
    private let titleField = UITextField()
    private let bodyField = UITextView()
    private let status = UILabel()
    private var saving = false
    private lazy var doneButton = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(save))
    private lazy var shareButton = UIBarButtonItem(barButtonSystemItem: .action, target: self, action: #selector(share))
    private var draftKey: String { "notes.native.draft." + (noteID.isEmpty ? "new" : noteID) }
    private var dirty: Bool { titleField.text != savedTitle || bodyField.text != savedBody }

    init(note: NoteSnapshot?) {
        noteID = note?.id ?? ""
        savedTitle = note?.title ?? ""
        savedBody = note?.body ?? ""
        super.init(nibName: nil, bundle: nil)
    }

    required init?(coder: NSCoder) { fatalError("init(coder:) is not supported") }

    override func viewDidLoad() {
        super.viewDidLoad()
        view.backgroundColor = .systemBackground
        title = noteID.isEmpty ? "New note" : "Note"
        navigationItem.largeTitleDisplayMode = .never
        doneButton.accessibilityIdentifier = "notes.done"
        shareButton.accessibilityIdentifier = "notes.share"
        shareButton.accessibilityLabel = "Share note"
        navigationItem.rightBarButtonItems = [doneButton, shareButton]
        titleField.font = .preferredFont(forTextStyle: .title1)
        titleField.adjustsFontForContentSizeCategory = true
        titleField.placeholder = "Title"
        titleField.accessibilityLabel = "Title"
        titleField.accessibilityIdentifier = "notes.title"
        titleField.returnKeyType = .next
        titleField.delegate = self
        titleField.addTarget(self, action: #selector(changed), for: .editingChanged)
        titleField.text = savedTitle
        bodyField.font = .preferredFont(forTextStyle: .body)
        bodyField.adjustsFontForContentSizeCategory = true
        bodyField.accessibilityLabel = "Note"
        bodyField.accessibilityIdentifier = "notes.body"
        bodyField.textContainerInset = .zero
        bodyField.textContainer.lineFragmentPadding = 0
        bodyField.alwaysBounceVertical = true
        bodyField.keyboardDismissMode = .interactive
        bodyField.delegate = self
        bodyField.text = savedBody
        status.font = .preferredFont(forTextStyle: .footnote)
        status.adjustsFontForContentSizeCategory = true
        status.numberOfLines = 0
        status.textColor = .secondaryLabel
        status.text = noteID.isEmpty ? "Not saved yet · tap Done to save" : "Saved on this device"
        status.accessibilityIdentifier = "notes.status"
        for control in [titleField, bodyField, status] {
            control.translatesAutoresizingMaskIntoConstraints = false
            view.addSubview(control)
        }
        let margins = view.layoutMarginsGuide
        NSLayoutConstraint.activate([
            titleField.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor, constant: 16),
            titleField.leadingAnchor.constraint(equalTo: margins.leadingAnchor),
            titleField.trailingAnchor.constraint(equalTo: margins.trailingAnchor),
            titleField.heightAnchor.constraint(greaterThanOrEqualToConstant: 44),
            status.topAnchor.constraint(equalTo: titleField.bottomAnchor, constant: 8),
            status.leadingAnchor.constraint(equalTo: margins.leadingAnchor),
            status.trailingAnchor.constraint(equalTo: margins.trailingAnchor),
            bodyField.topAnchor.constraint(equalTo: status.bottomAnchor, constant: 20),
            bodyField.leadingAnchor.constraint(equalTo: margins.leadingAnchor),
            bodyField.trailingAnchor.constraint(equalTo: margins.trailingAnchor),
            bodyField.bottomAnchor.constraint(equalTo: view.keyboardLayoutGuide.topAnchor, constant: -12)
        ])
        if let draft = UserDefaults.standard.dictionary(forKey: draftKey),
           let draftTitle = draft["title"] as? String, let draftBody = draft["body"] as? String {
            titleField.text = draftTitle
            bodyField.text = draftBody
            status.text = "Unsaved draft restored · tap Done to save"
        }
        updateBack()
    }

    override func viewWillAppear(_ animated: Bool) {
        super.viewWillAppear(animated)
        updateBack()
    }

    func textFieldShouldReturn(_ textField: UITextField) -> Bool {
        bodyField.becomeFirstResponder()
        return false
    }

    func textViewDidChange(_ textView: UITextView) { changed() }

    @objc private func changed() {
        if dirty {
            UserDefaults.standard.set(["title": titleField.text ?? "", "body": bodyField.text ?? ""], forKey: draftKey)
            status.text = "Unsaved changes · draft kept on this device"
        } else {
            UserDefaults.standard.removeObject(forKey: draftKey)
            status.text = noteID.isEmpty ? "Not saved yet · tap Done to save" : "Saved on this device"
        }
        updateBack()
    }

    private func updateBack() {
        navigationItem.hidesBackButton = dirty || saving
        navigationItem.leftBarButtonItem = dirty || saving ? UIBarButtonItem(title: "Notes", style: .plain, target: self, action: #selector(close)) : nil
        navigationItem.leftBarButtonItem?.isEnabled = !saving
        navigationController?.interactivePopGestureRecognizer?.isEnabled = !dirty && !saving
    }

    @objc private func close() {
        guard !saving else { return }
        let alert = UIAlertController(title: "Keep your draft?", message: "Your changes haven’t been saved as a note yet.", preferredStyle: .alert)
        alert.addAction(UIAlertAction(title: "Keep Editing", style: .cancel))
        alert.addAction(UIAlertAction(title: "Keep Draft", style: .default) { [weak self] _ in self?.navigationController?.popViewController(animated: true) })
        alert.addAction(UIAlertAction(title: "Discard Changes", style: .destructive) { [weak self] _ in
            guard let self else { return }
            UserDefaults.standard.removeObject(forKey: self.draftKey)
            self.navigationController?.popViewController(animated: true)
        })
        present(alert, animated: true)
    }

    @objc private func save() {
        guard !saving else { return }
        saving = true
        doneButton.isEnabled = false
        shareButton.isEnabled = false
        titleField.isEnabled = false
        bodyField.isEditable = false
        status.text = "Saving on this device…"
        updateBack()
        let oldDraftKey = draftKey
        NotesStore.save(noteID, title: titleField.text ?? "", body: bodyField.text ?? "") { [weak self] result in
            guard let self else { return }
            self.saving = false
            self.doneButton.isEnabled = true
            self.shareButton.isEnabled = true
            self.titleField.isEnabled = true
            self.bodyField.isEditable = true
            switch result {
            case .success(let note):
                self.noteID = note.id
                self.savedTitle = note.title
                self.savedBody = note.body
                self.titleField.text = note.title
                self.bodyField.text = note.body
                UserDefaults.standard.removeObject(forKey: oldDraftKey)
                self.status.text = "Saved on this device"
                UINotificationFeedbackGenerator().notificationOccurred(.success)
                UIAccessibility.post(notification: .announcement, argument: "Note saved")
                self.updateBack()
                self.navigationController?.popViewController(animated: true)
            case .failure(let error):
                self.status.text = "Couldn’t save · your text is still here"
                UINotificationFeedbackGenerator().notificationOccurred(.error)
                self.updateBack()
                self.showFailure(error)
            }
        }
    }

    @objc private func share() {
        let content = (titleField.text ?? "") + "\n\n" + (bodyField.text ?? "")
        let sheet = UIActivityViewController(activityItems: [content], applicationActivities: nil)
        sheet.popoverPresentationController?.barButtonItem = shareButton
        present(sheet, animated: true)
    }
}

private final class NativeInfoController: UIViewController {
    override func viewDidLoad() {
        super.viewDidLoad()
        title = "Native Notes"
        view.backgroundColor = .systemGroupedBackground
        navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(close))
        let text = UITextView()
        text.isEditable = false
        text.backgroundColor = .clear
        text.font = .preferredFont(forTextStyle: .body)
        text.adjustsFontForContentSizeCategory = true
        text.text = "Real UIKit screens. Shared Go behavior.\n\nNative navigation, search, text editing, keyboard layout, sharing, sheets, and accessibility text scaling. No WebView renders these screens.\n\nNotes stay in the same owner-scoped Go repository. Drafts are kept locally until you save or discard them."
        text.translatesAutoresizingMaskIntoConstraints = false
        view.addSubview(text)
        NSLayoutConstraint.activate([
            text.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor, constant: 16),
            text.leadingAnchor.constraint(equalTo: view.layoutMarginsGuide.leadingAnchor),
            text.trailingAnchor.constraint(equalTo: view.layoutMarginsGuide.trailingAnchor),
            text.bottomAnchor.constraint(equalTo: view.safeAreaLayoutGuide.bottomAnchor)
        ])
    }

    @objc private func close() { dismiss(animated: true) }
}

private extension UIViewController {
    func showFailure(_ error: Error) {
        let alert = UIAlertController(title: "Couldn’t finish", message: error.localizedDescription, preferredStyle: .alert)
        alert.addAction(UIAlertAction(title: "OK", style: .default))
        present(alert, animated: true)
    }
}
