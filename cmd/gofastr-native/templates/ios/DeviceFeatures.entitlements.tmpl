<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
{{if .AppGroup}}<key>com.apple.security.application-groups</key><array><string>{{xml .AppGroup}}</string></array>{{end}}
{{if .SecureStorage}}<key>application-identifier</key><string>{{xml .ID}}</string>
<key>keychain-access-groups</key><array><string>{{xml .ID}}</string></array>{{end}}
</dict></plist>
